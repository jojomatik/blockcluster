{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
