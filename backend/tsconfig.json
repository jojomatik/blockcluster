{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*", "tests/**/*.ts", "../common/tests/**/*.ts"]
}
