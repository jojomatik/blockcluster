{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "target": "es6",
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "paths": {
      "uuid": [
        "./node_modules/uuid"
      ]
    },
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
