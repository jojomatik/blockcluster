{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "config:js-app",
    "mergeConfidence:all-badges",
    ":semanticCommitTypeAll(build)",
  ],
  "labels": ["type:build"],
  "separateMultipleMajor": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      // Runtime dependencies take precedence across all updates in the branch.
      "semanticCommitScope": "{{#if (includes depTypes 'dependencies')}}deps{{else}}deps-dev{{/if}}",
      "addLabels": ["scope:deps-dev"],
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitScope": "deps-dev",
      "addLabels": ["scope:deps-dev"],
    },
    {
      "matchDepTypes": ["dependencies"],
      "addLabels": ["scope:deps"],
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["scope:deps"],
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeStrategy": "rebase",
    },
    {
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeStrategy": "rebase",
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["nuxt"],
      "automerge": false,
      "separateMultipleMinor": true,
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "separateMultipleMinor": true,
      "automerge": false,
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      // Recognize Java release/build tags, including updates from rolling major tags.
      "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?([._+](?<build>\\d+))?(-(?<compatibility>.*))?$",
      "groupName": null,
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    // Extend existing preset groups with their integrations.
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["vue", "vue-router", "@vue/test-utils"],
      "groupName": "vue",
      "separateMultipleMajor": false,
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/*", "@nuxt/test-utils", "happy-dom"],
      "groupName": "vitest",
      "separateMultipleMajor": false,
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["socket.io", "socket.io-client", "engine.io"],
      "groupName": "socket.io",
      "separateMultipleMajor": false,
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["apexcharts", "vue3-apexcharts"],
      "groupName": "apexcharts",
      "separateMultipleMajor": false,
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "/^(@types/)?(pidusage|properties-reader|semver|uuid)$/",
      ],
      "groupName": "{{{replace '^@types/' '' depName}}}",
      // Related packages can have different major version numbers.
      "separateMultipleMajor": false,
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@jojomatik/nuxt-bundle"],
      "automerge": true,
      "automergeStrategy": "rebase",
      "minimumReleaseAge": null,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true,
    },
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeStrategy": "rebase",
  },
}
