{
  // https://v3.nuxtjs.org/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "types": ["vitest/globals"]
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/nuxt.node.d.ts",
    ".storybook/**/*",
    "app/**/*",
    "scripts/**/*",
    "server/**/*",
    "shared/**/*",
    "tests/**/*",
    "*.js",
    "*.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules", ".output"]
}
